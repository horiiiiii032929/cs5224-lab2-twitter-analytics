# Copy this file to .env, fill ONE credential option, then run:
# npm run aws:run

AWS_REGION=ap-southeast-1

# Recommended: configure a school SSO profile once, then use browser sign-in.
# aws configure sso --profile school-sso
# AWS_PROFILE=school-sso
# An explicit profile overrides pasted credentials below.
# Optional protection against selecting a different account:
# LAB2_EXPECTED_ACCOUNT=123456789012

# Option 2: paste your AWS credentials (temporary credentials need all three).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# No bucket names, role ARNs, admin tokens or resource IDs are needed.
# The script discovers your public IP and restricts the web page to that IP.
# Optional override if automatic IP discovery is unavailable:
# LAB2_VIEWER_CIDR=203.0.113.10/32
