# AWS-backed API running on your computer. Copy to .env.runtime, fill values, then:
# npm run start:env
# EC2 deployed by CDK receives these settings automatically; no manual .env is needed there.
MODE=aws
HOST=127.0.0.1
PORT=3001
AWS_REGION=ap-southeast-1

# Fill from CDK's RuntimeEnvironment output, or run npm run env:aws after deployment.
DATA_BUCKET=replace-with-data-bucket
EMR_SERVICE_ROLE=arn:aws:iam::123456789012:role/replace-with-emr-service-role
EMR_INSTANCE_PROFILE=replace-with-emr-instance-profile-name
EMR_SUBNET_ID=subnet-replace-me
EMR_PRIMARY_SG=sg-replace-me
EMR_CORE_SG=sg-replace-me
EMR_RELEASE=emr-7.10.0
EMR_INSTANCE_TYPE=m5.xlarge

# Required: value of the secret identified by OperatorSecretArn. Never commit it.
ADMIN_TOKEN=

# Optional: use a locally configured AWS profile (do not put access keys here).
# AWS_PROFILE=your-profile
# VAR_DIR=./var
